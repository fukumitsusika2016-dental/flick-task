{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flick-task",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flick-task",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" },
  // 使える人（ALLOWED_EMAILS）とGoogleの鍵は wrangler secret で入れる（GitHubに書かない）
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_DAILY_LIMIT": "100"
  },
  "observability": { "enabled": true },

  // 手元テスト用（npm test）。Workers AI はCloudflareへのログインが要るので外し、AI_MOCK で代用する
  "env": {
    "test": {
      "d1_databases": [
        { "binding": "DB", "database_name": "flick-task", "migrations_dir": "migrations" }
      ],
      // DEV_LOGIN は localhost のときだけ効く（worker.js で二重に確認）
      // GOOGLE_* はテスト用のダミー（本物は wrangler secret で入れる）
      "vars": {
        "AI_MODEL": "mock",
        "AI_MOCK": "1",
        "AI_DAILY_LIMIT": "30",
        "DEV_LOGIN": "1",
        "GOOGLE_CLIENT_ID": "test-client.apps.googleusercontent.com",
        "GOOGLE_CLIENT_SECRET": "test-secret"
      }
    }
  }
}
